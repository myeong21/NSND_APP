<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    tools:context=".ui.sleepdata.SleepDataFragment">

    <!-- 상단 탭 레이아웃 (날짜별 리포트 / 운전 기록 목록) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutReport"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_pill"
        app:tabGravity="fill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="@color/accent_primary"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/accent_primary"
        app:tabTextAppearance="@style/TextAppearance.NSND.Body"
        app:tabTextColor="@color/text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="날짜별 분석" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운전 기록 히스토리" />
    </com.google.android.material.tabs.TabLayout>

    <!-- ───────────────────────────────────────── -->
    <!-- 탭 1: 날짜별 분석 뷰 컨테이너 -->
    <!-- ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutDateReportContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/layoutDateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선택한 날짜의 운전 안전 리포트"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    tools:text="2026년 9월 18일 (오늘)" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCalendar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_blue"
                android:contentDescription="날짜 선택"
                android:padding="10dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/accent_primary" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. 카카오맵 졸음 발생 위치 지도 카드 (화면 최상단 배치) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="졸음 발생 위치 (카카오맵)"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvMapEventCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_safe"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textColor="@color/accent_primary"
                                android:textSize="11sp"
                                tools:text="위치 3건" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="지도 상의 마커를 터치하면 상세 시각과 졸음 단계를 확인합니다."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- 카카오맵 뷰 프레임 -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="12dp">

                            <WebView
                                android:id="@+id/mapWebView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/tvMapEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/bg_surface"
                                android:gravity="center"
                                android:text="이 날짜에는 위치 정보가 포함된 졸음 기록이 없습니다."
                                android:textColor="@color/text_hint"
                                android:textSize="13sp"
                                android:visibility="gone" />
                        </FrameLayout>

                        <!-- 전체화면 지도로 보기 버튼 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenFullMap"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="전체화면 지도로 탐색하기"
                            android:textColor="@color/accent_primary"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_nav_map"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/accent_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. 안전 점수 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSafetyScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="오늘의 안전 점수"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <FrameLayout android:layout_width="110dp" android:layout_height="110dp">
                                <com.jsm.nsnd.ui.sleepdata.SafetyScoreRingView
                                    android:id="@+id/safetyScoreRing"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                                <TextView
                                    android:id="@+id/tvSafetyScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/text_primary"
                                    android:textSize="28sp"
                                    tools:text="92" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="18dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvSafetyGrade"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge_safe"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="11dp"
                                    android:paddingVertical="5dp"
                                    android:textColor="@color/status_safe"
                                    android:textSize="13sp"
                                    tools:text="안전" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:lineSpacingMultiplier="1.25"
                                    android:text="운전 중 감지된 졸음 기록을 기반으로 계산한 점수입니다."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="총 졸음 감지"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvTotalDrowsy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/text_primary"
                                    android:textSize="18sp"
                                    tools:text="3회" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="가장 위험했던 시간"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/tvDangerousTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/stage_2"
                                    android:textSize="18sp"
                                    tools:text="14:20" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 단계별 상세 카운트 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_card_pill"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1단계 (주의)"
                                    android:textColor="@color/stage_1"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvLevel1Count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    tools:text="2회" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2단계 (경고)"
                                    android:textColor="@color/stage_2"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvLevel2Count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    tools:text="1회" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3단계 (위험)"
                                    android:textColor="@color/stage_3"
                                    android:textSize="11sp" />
                                <TextView
                                    android:id="@+id/tvLevel3Count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    tools:text="0회" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. 시간대별 차트 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sleep_chart_label"
                            android:textAppearance="@style/TextAppearance.NSND.Title" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="시간대별로 기록된 최고 졸음 단계를 보여줍니다."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChart"
                            android:layout_width="match_parent"
                            android:layout_height="190dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. 감지 이벤트 목록 타이틀 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="상세 감지 기록"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:visibility="gone" />

                <!-- 빈 상태 뷰 -->
                <LinearLayout
                    android:id="@+id/layoutSleepEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="30dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivSleepEmpty"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_blue"
                        android:contentDescription="수면 데이터 상태"
                        android:padding="9dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/accent_primary" />

                    <TextView
                        android:id="@+id/tvSleepEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"
                        android:text="이 날짜에는 졸음 감지 기록이 없습니다."
                        android:textColor="@color/text_hint"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnRetrySleep"
                        style="@style/Widget.NSND.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:text="다시 시도"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSleepEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_sleep_event_card" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ───────────────────────────────────────── -->
    <!-- 탭 2: 전체 주행 기록(히스토리) 뷰 컨테이너 -->
    <!-- ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutHistoryContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="전체 운전 세션 기록"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnRefreshHistory"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_blue"
                android:contentDescription="히스토리 새로고침"
                android:padding="9dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/accent_primary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/historyProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

        <!-- 빈 히스토리 상태 뷰 -->
        <LinearLayout
            android:id="@+id/layoutHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_blue"
                android:padding="10dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/accent_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="저장된 운전 세션 기록이 없습니다."
                android:textColor="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 세션 히스토리 RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSessionHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            tools:listitem="@layout/item_session_history" />
    </LinearLayout>
</LinearLayout>
